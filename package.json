    "astro": "^7.3.7",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
