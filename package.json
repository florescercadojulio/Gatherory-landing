{
  "name": "gatherory-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-marketing-assets.mjs --report && astro build",
    "preview": "astro preview",
