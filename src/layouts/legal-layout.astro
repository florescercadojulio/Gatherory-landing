---
import "@/styles/global.css";
import { APP_SIGN_IN_URL } from "@/lib/site-links";
import { getTranslations } from "@/i18n";
import MobileNav from "@/lib/components/mobile-nav.svelte";

interface Props {
	title: string;
	accent: string;
	description: string;
	updated: string;
	activePage: "privacy" | "terms";
	releaseReview?: boolean;
}

const { title, accent, description, updated, activePage, releaseReview = false } = Astro.props;
const copy = getTranslations(Astro.currentLocale ?? "en");
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(activePage === "privacy" ? "/privacy" : "/terms", Astro.site)} />
		<link rel="icon" type="image/png" href="/gatherory-icon.png" />
		<link rel="apple-touch-icon" href="/gatherory-icon.png" />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:title" content={`${title} ${accent} · Gatherory`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/gatherory-icon.png" />
		<title>{title} {accent} · Gatherory</title>
	</head>
	<body>
		<div class="min-h-screen overflow-x-clip bg-background text-foreground">
			<header class="sticky top-0 z-50 border-b border-black/10 bg-white/95 backdrop-blur-xl">
				<div class="site-shell relative flex h-16 items-center justify-between">
					<a href="/" class="inline-flex items-center gap-2.5" aria-label={copy.nav.homeAria}>
						<img src="/gatherory-icon.png" alt="" class="size-8 rounded-lg" width="32" height="32" />
						<span class="text-base font-[540] tracking-[-0.02em]">Gatherory</span>
					</a>

					<nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 text-[0.95rem] font-[480] lg:flex" aria-label={copy.nav.legalNavigation}>
						<a class="nav-link" href="/">{copy.nav.home}</a>
						<a class:list={["nav-link", { "text-brand-blue": activePage === "privacy" }]} href="/privacy" aria-current={activePage === "privacy" ? "page" : undefined}>{copy.nav.privacy}</a>
						<a class:list={["nav-link", { "text-brand-blue": activePage === "terms" }]} href="/terms" aria-current={activePage === "terms" ? "page" : undefined}>{copy.nav.terms}</a>
					</nav>

					<a href={APP_SIGN_IN_URL} class="pill-button hidden h-11 px-5 text-[0.95rem] lg:inline-flex">{copy.nav.signIn}</a>
					<MobileNav client:load copy={copy} />
				</div>
			</header>

			<main>
				<section class="site-shell py-16 sm:py-24 lg:py-28">
					<div class="grid gap-10 border-b border-black/15 pb-14 sm:pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)] lg:items-end lg:gap-20">
						<h1 class="legal-title max-w-[10ch]">{title} <span class="text-brand-blue">{accent}</span></h1>
						<div>
							<p class="text-xl leading-8 sm:text-2xl sm:leading-9">{description}</p>
							<p class="mt-6 text-sm text-black/60">{copy.legal.lastUpdated.replace("{{date}}", updated)}</p>
						</div>
					</div>
				</section>

				<section class="site-shell pb-24 sm:pb-32">
					<div class="legal-document-grid">
						<aside class="legal-toc" aria-label={copy.legal.pageContents}>
							<p class="font-[540]">{copy.legal.onThisPage}</p>
							<slot name="toc" />
						</aside>

						<article class="legal-copy">
							{releaseReview && (
								<div class="mb-10 border-l-2 border-brand-blue pl-5" role="note">
								<p class="mt-0! font-semibold">{copy.legal.releaseReviewTitle}</p>
								<p>{copy.legal.releaseReviewDescription}</p>
								</div>
							)}
							<slot />
						</article>
					</div>
				</section>
			</main>

			<footer class="border-t border-black/10">
				<div class="site-shell grid gap-10 py-12 sm:grid-cols-[1fr_auto] sm:items-end">
					<div>
						<a href="/" class="inline-flex items-center gap-2.5 text-lg font-[540]" aria-label={copy.nav.homeAria}>
							<img src="/gatherory-icon.png" alt="" class="size-8 rounded-lg" width="32" height="32" />
							Gatherory
						</a>
						<p class="mt-5 max-w-sm text-sm">{copy.footer.description}</p>
					</div>
					<nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-[480]" aria-label={copy.nav.footerNavigation}>
						<a class="nav-link" href="/">{copy.nav.home}</a>
						<a class="nav-link" href="/privacy">{copy.nav.privacy}</a>
						<a class="nav-link" href="/terms">{copy.nav.terms}</a>
						<a class="nav-link" href={APP_SIGN_IN_URL}>{copy.nav.signIn}</a>
					</nav>
				</div>
			</footer>
		</div>
	</body>
</html>
