---
import "@/styles/global.css";
import { APP_SIGN_IN_URL, TESTFLIGHT_BETA_URL } from "@/lib/site-links";
import { getTranslations } from "@/i18n";
import MobileNav from "@/lib/components/mobile-nav.svelte";
import GuideImage from "@/lib/components/guide-image.astro";
import { getGuideAsset } from "@/lib/guide-assets";

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface RelatedPage {
	slug: string;
	title: string;
	description: string;
}

interface Props {
	slug: string;
	title: string;
	accent: string;
	seoTitle: string;
	description: string;
	intro: string;
	updated: Date;
	kind: "comparison" | "guide" | "product";
	heroAsset: string;
	summaryHeading: string;
	takeaways: string[];
	headings: Heading[];
	relatedPages: RelatedPage[];
}

const {
	slug,
	title,
	accent,
	seoTitle,
	description,
	intro,
	updated,
	kind,
	heroAsset,
	summaryHeading,
	takeaways,
	headings,
	relatedPages,
} = Astro.props;
const copy = getTranslations(Astro.currentLocale ?? "en");
const heroImage = getGuideAsset(heroAsset);

const updatedLabel = new Intl.DateTimeFormat(Astro.currentLocale ?? "en", {
	month: "long",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
}).format(updated);
const canonical = new URL(`/${slug}`, Astro.site);
const structuredData = {
	"@context": "https://schema.org",
	"@type": kind === "product" ? "TechArticle" : "Article",
	headline: `${title} ${accent}`,
	description,
	image: new URL(heroImage.src, Astro.site).toString(),
	inLanguage: Astro.currentLocale ?? "en",
	dateModified: updated.toISOString(),
	mainEntityOfPage: canonical.toString(),
	author: { "@type": "Organization", name: "Gatherory", url: Astro.site?.toString() },
	publisher: {
		"@type": "Organization",
		name: "Gatherory",
		url: Astro.site?.toString(),
		logo: { "@type": "ImageObject", url: new URL("/gatherory-icon.png", Astro.site).toString() },
	},
};
---

<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/gatherory-icon.png" />
		<link rel="apple-touch-icon" href="/gatherory-icon.png" />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={seoTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(heroImage.src, Astro.site)} />
		<meta property="og:image:alt" content={heroImage.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={new URL(heroImage.src, Astro.site)} />
		<meta name="twitter:title" content={seoTitle} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<title>{seoTitle}</title>
	</head>
	<body>
		<div class="min-h-screen overflow-x-clip bg-background text-foreground">
			<header class="sticky top-0 z-50 border-b border-black/10 bg-white/95 backdrop-blur-xl">
				<div class="site-shell relative flex h-16 items-center justify-between">
					<a href="/" class="inline-flex items-center gap-2.5" aria-label={copy.nav.homeAria}>
						<img src="/gatherory-icon.png" alt="" class="size-8 rounded-lg" width="32" height="32" />
						<span class="text-base font-[540] tracking-[-0.02em]">Gatherory</span>
					</a>

					<nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 text-[0.95rem] font-[480] lg:flex" aria-label={copy.nav.mainNavigation}>
						<a class="nav-link" href="/">{copy.nav.home}</a>
						<a class="nav-link text-brand-blue" href="/resources">{copy.nav.guides}</a>
						<a class="nav-link" href="/iphone">{copy.nav.product}</a>
					</nav>

					<a href={APP_SIGN_IN_URL} class="pill-button hidden h-11 px-5 text-[0.95rem] lg:inline-flex">{copy.nav.signIn}</a>
					<MobileNav client:load copy={copy} />
				</div>
			</header>

			<main>
				<section class="site-shell py-16 sm:py-24 lg:py-28">
					<div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-x-14">
						<h1 class="seo-title max-w-[15ch] lg:col-start-1 lg:row-start-1 lg:self-end lg:text-[4.25rem]">{title} <span class="text-brand-blue">{accent}</span></h1>
						<div class="lg:col-start-1 lg:row-start-2 lg:self-start">
						<p class="max-w-3xl text-xl leading-8 sm:text-2xl sm:leading-9">{intro}</p>
						<p class="mt-6 text-sm text-black/60">{copy.seo.updatedBy.replace("{{date}}", updatedLabel)}</p>
						</div>
						<div class="row-start-2 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
							<GuideImage asset={heroImage} />
						</div>
					</div>
				</section>

				<section class="site-shell pb-14 sm:pb-20">
					<div class="seo-summary">
						<h2>{summaryHeading}</h2>
						<ul>
							{takeaways.map((takeaway) => <li>{takeaway}</li>)}
						</ul>
					</div>
				</section>

				<section class="site-shell pb-24 sm:pb-32">
					<div class="seo-document-grid">
						<aside class="seo-toc" aria-label={copy.seo.pageContents}>
							<p class="font-[540]">{copy.seo.onThisPage}</p>
							<ol>
								{headings.filter((heading) => heading.depth === 2).map((heading) => (
									<li><a href={`#${heading.slug}`}>{heading.text}</a></li>
								))}
							</ol>
						</aside>

						<article class="seo-copy">
							<slot />
						</article>
					</div>
				</section>

				<section class="border-y border-black/10 bg-surface-soft">
					<div class="site-shell py-20 sm:py-24">
						<div class="grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
							<h2 class="section-title max-w-[8ch]">{copy.seo.keepPlanning}</h2>
							<div class="grid gap-4 sm:grid-cols-2">
								{relatedPages.map((page) => (
									<a href={`/${page.slug}`} class="guide-card">
										<h3>{page.title}</h3>
										<p>{page.description}</p>
									<span>{copy.seo.readGuide}</span>
									</a>
								))}
							</div>
						</div>
					</div>
				</section>

				<section class="site-shell py-24 sm:py-32">
					<div class="rounded-[2rem] bg-black px-6 py-14 text-center text-white sm:px-12 sm:py-20">
						<h2 class="section-title mx-auto max-w-[12ch]">{copy.seo.finalCtaTitle}</h2>
						<p class="mx-auto mt-6 max-w-xl text-lg leading-7 text-white/80">{copy.seo.finalCtaDescription}</p>
						<a href={TESTFLIGHT_BETA_URL} class="pill-button-inverse mt-8 h-12 px-7 text-base">{copy.seo.startPlanning}</a>
					</div>
				</section>
			</main>

			<footer class="border-t border-black/10">
				<div class="site-shell grid gap-10 py-12 sm:grid-cols-[1fr_auto] sm:items-end">
					<div>
						<a href="/" class="inline-flex items-center gap-2.5 text-lg font-[540]" aria-label={copy.nav.homeAria}>
							<img src="/gatherory-icon.png" alt="" class="size-8 rounded-lg" width="32" height="32" /> Gatherory
						</a>
						<p class="mt-5 max-w-sm text-sm">{copy.footer.description}</p>
					</div>
					<nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-[480]" aria-label={copy.nav.footerNavigation}>
						<a class="nav-link" href="/resources">{copy.nav.guides}</a>
						<a class="nav-link" href="/privacy">{copy.nav.privacy}</a>
						<a class="nav-link" href="/terms">{copy.nav.terms}</a>
						<a class="nav-link" href={APP_SIGN_IN_URL}>{copy.nav.signIn}</a>
					</nav>
				</div>
			</footer>
		</div>
	</body>
</html>
