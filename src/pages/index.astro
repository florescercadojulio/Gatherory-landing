---
import "@/styles/global.css";
import LandingPage from "@/lib/components/landing/landing-page.svelte";

const canonical = new URL("/", Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Gatherory brings events, ideas, decisions, and people into one shared planning space." />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/gatherory-icon.png" />
		<link rel="apple-touch-icon" href="/gatherory-icon.png" />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:title" content="Gatherory · Bring every part of the gathering together" />
		<meta property="og:description" content="Plan the event, shape the moments around it, and invite people into exactly the context they need." />
		<meta property="og:image" content="/gatherory-icon.png" />
		<meta property="og:url" content={canonical} />
		<title>Gatherory · Plan every part together</title>
	</head>
	<body>
		<LandingPage client:load />
	</body>
</html>
