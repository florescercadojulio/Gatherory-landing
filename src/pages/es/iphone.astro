---
import "@/styles/global.css";
import IphonePage from "@/lib/components/landing/iphone-page.svelte";
import { getIphoneCopy } from "@/lib/iphone-copy";

const locale = "es";
const copy = getIphoneCopy(locale);
const canonical = new URL(locale === "es" ? "/es/iphone" : "/iphone", Astro.site);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={copy.metaDescription} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={new URL("/iphone", Astro.site)} />
		<link rel="alternate" hreflang="es" href={new URL("/es/iphone", Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL("/iphone", Astro.site)} />
		<link rel="icon" type="image/png" href="/gatherory-icon.png" />
		<link rel="apple-touch-icon" href="/gatherory-icon.png" />
		<meta name="theme-color" content="#ffffff" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={copy.metaTitle} />
		<meta property="og:description" content={copy.metaDescription} />
		<meta property="og:image" content={new URL("/gatherory-icon.png", Astro.site)} />
		<meta property="og:url" content={canonical} />
		<title>{copy.metaTitle}</title>
	</head>
	<body>
		<IphonePage client:load {copy} {locale} />
	</body>
</html>
